API_HOST=0.0.0.0
API_PORT=1323
DATABASE_URL=postgres://user:pass@localhost:5432/control?sslmode=disable

# dev | prod. dev: no password rules + non-Secure cookies (http localhost).
# prod: strong password rules + Secure cookies (and JWT_SECRET is required).
APP_ENV=dev
# Signing key for access-token JWTs. Generate a strong random value for prod.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRY_MINS=5
REFRESH_TOKEN_EXPIRY_DAYS=7

# Key the /login hand-off signs proxy tokens with. Must be the same bytes every
# host's proxy has in its cookie_secret_file, and at least 32 of them. Used as
# raw bytes exactly as read: a hex string is the key, not what it decodes to.
# Either set the value here or point PROXY_AUTH_SECRET_FILE at the shared file.
PROXY_AUTH_SECRET=
# PROXY_AUTH_SECRET_FILE=/etc/dpipe/cookie_secret

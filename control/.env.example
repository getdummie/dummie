API_HOST=0.0.0.0
API_PORT=1323
DATABASE_URL=postgres://user:pass@localhost:5432/control?sslmode=disable

# dev | prod. dev: no password rules + non-Secure cookies (http localhost).
# prod: strong password rules + Secure cookies (and JWT_SECRET is required).
APP_ENV=dev
# Signing key for access-token JWTs. Generate a strong random value for prod.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRY_MINS=5
REFRESH_TOKEN_EXPIRY_DAYS=7

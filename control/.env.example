API_HOST=0.0.0.0
API_PORT=1323
DATABASE_URL=postgres://user:pass@localhost:5432/control?sslmode=disable

# dev | prod. dev: no password rules + non-Secure cookies (http localhost).
# prod: strong password rules + Secure cookies (and JWT_SECRET is required).
APP_ENV=dev
# Signing key for access-token JWTs. Generate a strong random value for prod.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRY_MINS=5
REFRESH_TOKEN_EXPIRY_DAYS=7

# The origin browsers reach this server on. Goes into every host's proxy.yaml as
# "<CONTROL_URL>/login", so it has to be reachable from wherever the users of
# those guests are -- not the address this process binds. Required when
# APP_ENV=prod; defaults to http://localhost:1323 in dev.
CONTROL_URL=http://localhost:1323
# Key the /login hand-off signs proxy tokens with. Must be the same bytes every
# host's proxy has in its cookie_secret_file, and at least 32 of them. Used as
# raw bytes exactly as read: a hex string is the key, not what it decodes to.
# Either set the value here or point PROXY_AUTH_SECRET_FILE at the shared file.
PROXY_AUTH_SECRET=
# PROXY_AUTH_SECRET_FILE=/etc/dpipe/keys/cookie_secret

# Object storage for uploaded kernel images. Leave S3_BUCKET empty and the
# server still starts; the admin kernels section then reports storage as
# unconfigured instead of accepting uploads it cannot keep.
S3_BUCKET=
S3_REGION=us-east-1
# Set for anything that is not AWS S3 itself (MinIO, Ceph, Cloudflare R2). Also
# switches on path-style addressing, which those endpoints need.
# S3_ENDPOINT=http://localhost:9000
# The same store as a browser reaches it. Set this when S3_ENDPOINT is a name
# only this server can resolve -- a compose service name, say -- because the
# host is part of what a presigned link signs and cannot be swapped afterwards.
# Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=false
# Key prefix inside the bucket. Defaults to "kernels".
# S3_PREFIX=kernels
# Credentials. Leave both empty to use the default AWS chain (AWS_* environment
# variables, ~/.aws/config, or the instance role) -- preferred in production.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long a generated download link stays valid, and the largest upload the
# server accepts.
S3_PRESIGN_EXPIRY_MINS=15
KERNEL_MAX_UPLOAD_MIB=2048

default: build

# Build the dproxy binary.
build:
    go build -o dproxy ./cmd/dproxy

# Unit + integration tests.
test:
    go test ./...

# Tests under the race detector.
race:
    go test -race ./...

lint:
    go vet ./...

# Generate the demo keys and certificates.
keys:
    ./scripts/keys.sh

# Full dproxy + dpipe demo (builds both repos).
demo:
    ./scripts/demo.sh

clean:
    rm -rf bin
